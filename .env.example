# Anthropic API Key for Claude
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Resend API Key for dispatching newsletters
RESEND_API_KEY=your_resend_api_key_here

# Recipient profile details
USER_NAME=Alex
USER_EMAIL=alex@example.com
# Sender email (leave blank to default to: News Briefing <onboarding@resend.dev>)
SENDER_EMAIL=onboarding@resend.dev
USER_INTERESTS=AI advancements,TypeScript,Web Development,Space Exploration
USER_TONE=informative, modern, with a touch of wit
USER_PREFERENCES=Exclude generic marketing fluff. Focus on deep technical write-ups.
