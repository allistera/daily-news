<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Daily News</title>
</head>
<body style="background-color:#f6f6ef; margin:0; padding:0; -webkit-text-size-adjust:100%; -ms-text-size-adjust:100%;">
  <center>
    <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f6f6ef; max-width:650px; margin:0 auto; text-align:left; font-family:Verdana,Geneva,sans-serif;">

      <!-- HEADER BAR (HN orange) -->
      <tr>
        <td style="background-color:#ff6600; padding:2px 6px;">
          <span style="border:1px solid #ffffff; padding:0 3px; font-weight:bold; color:#000000; font-size:13px; font-family:Verdana,Geneva,sans-serif;">DN</span>
          <span style="color:#000000; font-weight:bold; font-size:13px; font-family:Verdana,Geneva,sans-serif; margin-left:4px;">Daily News</span>
        </td>
      </tr>

      <!-- TAGLINE -->
      <tr>
        <td style="padding:6px 8px 0;">
          <span style="color:#828282; font-size:11px; font-family:Verdana,Geneva,sans-serif;">Yesterday's top GitHub repos and Product Hunt launches.</span>
        </td>
      </tr>

      <!-- SPACER -->
      <tr><td style="height:10px; line-height:10px; font-size:10px;">&nbsp;</td></tr>

      <!-- SECTIONS -->
      <tr>
        <td style="padding:0 8px;">
          {% for section, items in sections.items() %}
          <!-- section heading -->
          <table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:5px;">
            <tr>
              <td style="border-bottom:1px solid #ff6600; padding-bottom:2px;">
                <span style="color:#000000; font-size:12px; font-weight:bold; text-transform:uppercase; letter-spacing:0.04em; font-family:Verdana,Geneva,sans-serif;">{{ section }}</span>
              </td>
            </tr>
          </table>
          <!-- section items -->
          <table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:16px;">
            {% for item in items %}
            <tr>
              <td align="right" valign="top" width="22" style="color:#828282; font-size:13px; font-family:Verdana,Geneva,sans-serif; padding-right:3px; line-height:1.5;">{{ loop.index }}.</td>
              <td valign="top" width="12" style="color:#999999; font-size:10px; font-family:Verdana,Geneva,sans-serif; padding-top:3px; line-height:1.5;">&#9650;</td>
              <td valign="top" style="line-height:1.5; padding-bottom:8px;">
                <a href="{{ item.url }}" target="_blank" style="color:#000000; font-size:13px; text-decoration:none; font-family:Verdana,Geneva,sans-serif;">{{ item.title }}</a>
                {% if item.description %}
                <div style="color:#828282; font-size:11px; font-family:Verdana,Geneva,sans-serif; line-height:1.4; margin-top:1px;">{{ item.description }}</div>
                {% endif %}
              </td>
            </tr>
            {% endfor %}
          </table>
          {% endfor %}
        </td>
      </tr>

      <!-- FOOTER -->
      <tr>
        <td style="border-top:2px solid #ff6600; padding:8px 6px; text-align:center;">
          <span style="color:#828282; font-size:10px; font-family:Verdana,Geneva,sans-serif;">Generated using Daily News</span>
        </td>
      </tr>

    </table>
  </center>
</body>
</html>
